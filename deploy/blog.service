[Unit]
Description=HONGS blog (gunicorn)
After=network.target

[Service]
User=hongs
WorkingDirectory=/srv/blog
EnvironmentFile=/srv/blog/.env
# 单 worker:后台保存后直接重载进程内缓存,多 worker 会导致其他 worker 看不到更新
ExecStart=/srv/blog/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
